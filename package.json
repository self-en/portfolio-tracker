{
  "name": "portfolio-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:api": "SCHEDULER_ENABLED=false node server.js",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "test": "node --test test/",
    "test:domain": "node --test test/domain/",
    "test:coverage": "node --test --experimental-test-coverage test/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "yahoo-finance2": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
